impl QuietOrderingState {
    pub(crate) const fn new() -> Self {
        Self {
            killers: [KillerMoves {
                primary: None,
                secondary: None,
            }; ORDERING_PLY_COUNT],
            history: [[[0; 64]; 64]; 2],
